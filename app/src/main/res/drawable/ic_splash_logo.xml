<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash mark: the launcher icon's rising chart, so the icon tapped and the screen
  it opens match. Drawn a little smaller, because Android 12 and later show the
  splash icon through a circle two thirds of the canvas wide, and the chart's
  arrow tip would otherwise touch its edge.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground"
    android:inset="8%" />
