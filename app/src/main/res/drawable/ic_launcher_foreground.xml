<?xml version="1.0" encoding="utf-8"?>
<!--
  eSales Manager: a team's figures going up — three rising bars under a trend
  arrow. Drawn inside the adaptive icon's 66dp safe zone (21..87), so no launcher
  mask clips it. Also the monochrome layer, which is why it is a single colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bars, shortest to tallest, with rounded tops. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M33,62a3,3 0,0 1,3 -3h4a3,3 0,0 1,3 3v14h-10z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48.5,54a3,3 0,0 1,3 -3h4a3,3 0,0 1,3 3v22h-10z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M64,46a3,3 0,0 1,3 -3h4a3,3 0,0 1,3 3v30h-10z" />
    <!-- Base line. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M30,77h48a1.5,1.5 0,0 1,0 3h-48a1.5,1.5 0,0 1,0 -3z" />
    <!-- Trend line over the bars, ending in an arrow. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M32,51L46,40L54,45L72,30" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M77,26L74.6,36.2L66.8,28.4z" />
</vector>
